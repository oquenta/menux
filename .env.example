# =============================================================
# RestoSuite — Variables de entorno para despliegue en Coolify
# =============================================================

# 1. Base de datos PostgreSQL
# En Coolify, usa la URL interna de tu Postgres (ej. postgresql://resto:password@db:5432/resto?schema=public)
# o la URL externa de Supabase / Neon / RDS.
DATABASE_URL="postgresql://resto:resto@localhost:5432/resto?schema=public"

# 2. Clave secreta para cookies de sesión (HMAC)
# Genera con: openssl rand -base64 32
APP_SECRET="cambia-esta-clave-larga-y-secreta-en-produccion"

# 3. URL pública de la aplicación
# Muy importante para generar los códigos QR de las mesas que escanearán los clientes.
# Ejemplos: "https://resto.tudominio.com" o "http://tu-ip-de-vps:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Puerto de escucha (por defecto 3000)
PORT=3000
NODE_ENV=production

# 5. Credenciales del Superadmin inicial (creado automáticamente en el primer despliegue)
SEED_ADMIN_EMAIL="admin@resto.app"
SEED_ADMIN_PASSWORD="demo1234"

# 6. Opcional: Re-sembrar datos (CUIDADO: borra datos existentes si es true)
# FORCE_SEED="false"
