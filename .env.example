# ============ RestoSuite — Variables de entorno ============
# Base de datos (Neon/Supabase free tier o Postgres local)
DATABASE_URL="postgresql://resto:resto@localhost:5432/resto?schema=public"

# Auth.js v5 — genera con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esta-clave-larga-y-unica"

# Cifrado de credenciales de APIs de pago (AES-256-GCM) — openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY="reemplaza-con-64-chars-hex"

# Opcional: correo para avisos de vencimiento (Resend free tier)
# RESEND_API_KEY=""
# MAIL_FROM="avisos@tudominio.com"

# URL publica (para QR de mesas en produccion)
# NEXT_PUBLIC_APP_URL="https://tuapp.vercel.app"

# Superadmin inicial (usado por prisma/seed)
SEED_ADMIN_EMAIL="admin@restosuite.app"
SEED_ADMIN_PASSWORD="admin1234"
